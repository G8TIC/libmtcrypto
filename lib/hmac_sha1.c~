

#include <stddef.h>
#include <stdint.h>
#include <string.h>

#include "hmac_sha1.h"

#define IPAD 0x36
#define OPAD 0x5c


/*
 * secure_clear() - clear sensitive temporary data
 *
 * The volatile pointer should prevent the compiler's optimiser from removing the
 * memory writes because the memory is not subsequently read.
 */
static void secure_clear(void *data, size_t len)
{
        volatile uint8_t *p = data;

        while (len) {
                *p++ = 0;
                --len;
        }
}


/*
 * hmac_sha1_init() - initialise a streaming HMAC-SHA-1 operation
 *
 * HMAC is defined as:
 *
 *     HMAC(K, m) =
 *         SHA1((K xor opad) ||
 *              SHA1((K xor ipad) || m))
 */
void hmac_sha1_init(hmac_sha1_ctx_t *ctx, const uint8_t *key, size_t key_len)
{
        uint8_t key_block[HMAC_SHA1_BLOCK_SIZE];
        uint8_t inner_pad[HMAC_SHA1_BLOCK_SIZE];
        uint8_t outer_pad[HMAC_SHA1_BLOCK_SIZE];

        /*
         * Keys longer than the SHA-1 block size are first reduced to one
         * SHA-1 digest. Shorter keys are padded with zeroes.
         */
        memset(key_block, 0, sizeof(key_block));

        if (key_len > HMAC_SHA1_BLOCK_SIZE) {
                uint8_t hash[HMAC_SHA1_DIGEST_SIZE];
        
                sha1(hash, key, key_len);
                memcpy(key_block, hash, HMAC_SHA1_DIGEST_SIZE);
        } else {
                memcpy(key_block, key, key_len);
        }

        /*
         * Construct the inner and outer padding blocks.
         */
        for (int i = 0; i < HMAC_SHA1_BLOCK_SIZE; ++i) {
                inner_pad[i] = (uint8_t)(key_block[i] ^ IPAD);
                outer_pad[i] = (uint8_t)(key_block[i] ^ OPAD);
        }

        /*
         * Preload the inner and outer SHA-1 contexts.
         */
        sha1_init(&ctx->inner_ctx);
        sha1_update(&ctx->inner_ctx, inner_pad, sizeof(inner_pad));

        sha1_init(&ctx->outer_ctx);
        sha1_update(&ctx->outer_ctx, outer_pad, sizeof(outer_pad));

        secure_clear(key_block, sizeof(key_block));
        secure_clear(inner_pad, sizeof(inner_pad));
        secure_clear(outer_pad, sizeof(outer_pad));
}


/*
 * hmac_sha1_update() - add data to a streaming HMAC-SHA-1 operation
 */
void hmac_sha1_update(hmac_sha1_ctx_t *ctx, const void *data, size_t data_len)
{
        if (data_len > 0)
                sha1_update(&ctx->inner_ctx, data, data_len);
}


/*
 * hmac_sha1_final() - complete a streaming HMAC-SHA-1 operation
 */
void hmac_sha1_final(hmac_sha1_ctx_t *ctx, uint8_t out[HMAC_SHA1_DIGEST_SIZE])
{
        uint8_t inner_digest[HMAC_SHA1_DIGEST_SIZE];

        sha1_final(&ctx->inner_ctx, inner_digest);
        sha1_update(&ctx->outer_ctx, inner_digest, sizeof(inner_digest));
        sha1_final(&ctx->outer_ctx, out);

        secure_clear(inner_digest, HMAC_SHA1_DIGEST_SIZE);
        secure_clear(ctx, sizeof(hmac_sha1_ctx_t));
}


/*
 * hmac_sha1() - one-shot HMAC-SHA-1 wrapper
 */
void hmac_sha1(uint8_t out[HMAC_SHA1_DIGEST_SIZE], const uint8_t *key, size_t key_len, const void *data, size_t data_len)
{
        hmac_sha1_ctx_t ctx;

        hmac_sha1_init(&ctx, key, key_len);
        hmac_sha1_update(&ctx, data, data_len);
        hmac_sha1_final(&ctx, out);
}
