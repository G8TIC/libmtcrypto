#include <string.h>

#include "sha1.h"
#include "secure.h"


#define SHA1_INITIAL_STATE_0 UINT32_C(0x67452301)
#define SHA1_INITIAL_STATE_1 UINT32_C(0xefcdab89)
#define SHA1_INITIAL_STATE_2 UINT32_C(0x98badcfe)
#define SHA1_INITIAL_STATE_3 UINT32_C(0x10325476)
#define SHA1_INITIAL_STATE_4 UINT32_C(0xc3d2e1f0)

#define SHA1_CONSTANT_0 UINT32_C(0x5a827999)
#define SHA1_CONSTANT_1 UINT32_C(0x6ed9eba1)
#define SHA1_CONSTANT_2 UINT32_C(0x8f1bbcdc)
#define SHA1_CONSTANT_3 UINT32_C(0xca62c1d6)

static uint32_t sha1_rotate_left(uint32_t value, unsigned int shift)
{
    return (value << shift) | (value >> (32 - shift));
}

static uint32_t sha1_load_be32(const uint8_t input[4])
{
    return ((uint32_t)input[0] << 24)
         | ((uint32_t)input[1] << 16)
         | ((uint32_t)input[2] << 8)
         | ((uint32_t)input[3]);
}

static void sha1_store_be32(uint8_t output[4], uint32_t value)
{
    output[0] = (uint8_t)(value >> 24);
    output[1] = (uint8_t)(value >> 16);
    output[2] = (uint8_t)(value >> 8);
    output[3] = (uint8_t)value;
}

static void sha1_store_be64(uint8_t output[8], uint64_t value)
{
    output[0] = (uint8_t)(value >> 56);
    output[1] = (uint8_t)(value >> 48);
    output[2] = (uint8_t)(value >> 40);
    output[3] = (uint8_t)(value >> 32);
    output[4] = (uint8_t)(value >> 24);
    output[5] = (uint8_t)(value >> 16);
    output[6] = (uint8_t)(value >> 8);
    output[7] = (uint8_t)value;
}

static void sha1_transform(sha1_ctx_t *ctx, const uint8_t block[SHA1_BLOCK_SIZE])
{
    uint32_t words[80];
    uint32_t a;
    uint32_t b;
    uint32_t c;
    uint32_t d;
    uint32_t e;
    uint32_t function;
    uint32_t constant;
    uint32_t tmp;
    unsigned int i;

    for (i = 0; i < 16; ++i) {
        words[i] = sha1_load_be32(&block[i * 4]);
    }

    for (i = 16; i < 80; ++i) {
        words[i] = sha1_rotate_left(
            words[i - 3]
            ^ words[i - 8]
            ^ words[i - 14]
            ^ words[i - 16],
            1
        );
    }

    a = ctx->state[0];
    b = ctx->state[1];
    c = ctx->state[2];
    d = ctx->state[3];
    e = ctx->state[4];

    for (i = 0; i < 80; ++i) {
        if (i < 20) {
            function = (b & c) | ((~b) & d);
            constant = SHA1_CONSTANT_0;
        } else if (i < 40) {
            function = b ^ c ^ d;
            constant = SHA1_CONSTANT_1;
        } else if (i < 60) {
            function = (b & c) | (b & d) | (c & d);
            constant = SHA1_CONSTANT_2;
        } else {
            function = b ^ c ^ d;
            constant = SHA1_CONSTANT_3;
        }

        tmp = sha1_rotate_left(a, 5) + function + e + constant + words[i];
        e = d;
        d = c;
        c = sha1_rotate_left(b, 30);
        b = a;
        a = tmp;
    }

    ctx->state[0] += a;
    ctx->state[1] += b;
    ctx->state[2] += c;
    ctx->state[3] += d;
    ctx->state[4] += e;

    /*
     * Clear the message schedule because it may contain message material.
     * A sufficiently aggressive optimiser may remove this memset; use a
     * platform-specific secure zeroing function where that matters.
     */
    //memset(words, 0, sizeof(words));
    secure_clear(words, sizeof(words));
}

void sha1_init(sha1_ctx_t *ctx)
{
    if (ctx == NULL) {
        return;
    }

    ctx->state[0] = SHA1_INITIAL_STATE_0;
    ctx->state[1] = SHA1_INITIAL_STATE_1;
    ctx->state[2] = SHA1_INITIAL_STATE_2;
    ctx->state[3] = SHA1_INITIAL_STATE_3;
    ctx->state[4] = SHA1_INITIAL_STATE_4;

    ctx->total_length = UINT64_C(0);
    ctx->buffer_length = 0;

    secure_clear(ctx->buffer, sizeof(ctx->buffer));
}

void sha1_update(sha1_ctx_t *ctx, const void *data, size_t length)
{

    if (data && length) {
    const uint8_t *input;
    size_t copy_length;
        
    

        input = (const uint8_t *)data;

        /*
         * SHA-1 encodes the message length modulo 2^64 bits, so unsigned
         * wraparound of total_length is intentional.
         */
        ctx->total_length += (uint64_t)length;

        if (ctx->buffer_length != 0) {
            copy_length = SHA1_BLOCK_SIZE - ctx->buffer_length;

            if (copy_length > length) {
                copy_length = length;
            }

            memcpy(&ctx->buffer[ctx->buffer_length], input, copy_length);

            ctx->buffer_length += copy_length;
            input += copy_length;
            length -= copy_length;

            if (ctx->buffer_length == SHA1_BLOCK_SIZE) {
                sha1_transform(ctx, ctx->buffer);
                ctx->buffer_length = 0;
            }
        }

        while (length >= SHA1_BLOCK_SIZE) {
            sha1_transform(ctx, input);
            input += SHA1_BLOCK_SIZE;
            length -= SHA1_BLOCK_SIZE;
        }

        if (length != 0) {
            memcpy(ctx->buffer, input, length);
            ctx->buffer_length = length;
        }
    }
}


void sha1_final(sha1_ctx_t *ctx, uint8_t digest[SHA1_DIGEST_SIZE])
{
    uint64_t total_bits;
    size_t i;

    if (ctx == NULL || digest == NULL) {
        return;
    }

    total_bits = ctx->total_length * UINT64_C(8);

    ctx->buffer[ctx->buffer_length++] = UINT8_C(0x80);

    if (ctx->buffer_length > 56) {
        memset(&ctx->buffer[ctx->buffer_length], 0, SHA1_BLOCK_SIZE - ctx->buffer_length );
        sha1_transform(ctx, ctx->buffer);
        ctx->buffer_length = 0;
    }

    memset(&ctx->buffer[ctx->buffer_length], 0, 56 - ctx->buffer_length);

    sha1_store_be64(&ctx->buffer[56], total_bits);
    sha1_transform(ctx, ctx->buffer);

    for (i = 0; i < 5; ++i) {
        sha1_store_be32(&digest[i * 4], ctx->state[i]);
    }

    //memset(ctx, 0, sizeof(*ctx));
    secure_clear(ctx, sizeof(*ctx));
}


void sha1(uint8_t *out, const void *data, size_t length)
{
    if (out) {
        sha1_ctx_t ctx;

        sha1_init(&ctx);
        sha1_update(&ctx, data, length);
        sha1_final(&ctx, out);
    }
}

